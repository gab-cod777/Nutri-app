# NutriSnap IA (Python + FastAPI) - variaveis de ambiente

# SEGREDO compartilhado com a API Node (mesmo valor de IA_INTERNAL_TOKEN la).
IA_INTERNAL_TOKEN="troque-por-um-token-interno-aleatorio"
# Modelo de visao (Hugging Face). Baixado no primeiro start (~600 MB, fica em cache).
IA_MODEL_NAME="openai/clip-vit-base-patch32"
IA_MAX_IMAGE_BYTES=5242880
# Opcional: caminho da tabela de alimentos (padrao: app/dados/alimentos.json)
# IA_ALIMENTOS_PATH=
