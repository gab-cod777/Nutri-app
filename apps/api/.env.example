# =============================================================================
# NutriSnap API (Node + Express) - variaveis de ambiente
#
# Copie para `.env` e preencha. NUNCA comite o `.env`. Nada daqui vai para o app.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# warn = terminal limpo na apresentacao. Use info/debug para ver cada requisicao.
LOG_LEVEL=warn
# true atras de proxy/load balancer (rate limit por IP precisa do IP real)
TRUST_PROXY=false

# --- Banco de dados (PostgreSQL) ---------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrisnap?schema=public"
# Usada so pelo `prisma migrate`. Em dev pode ser igual a DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrisnap?schema=public"

# --- Autenticacao propria ----------------------------------------------------
# SEGREDO dos tokens JWT emitidos pela API. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN_DAYS=30

# --- Servico de IA (Python, apps/ia) -----------------------------------------
# Rede interna: o app nunca fala com ele, so a API.
IA_SERVICE_URL="http://localhost:8000"
# SEGREDO compartilhado com o servico de IA (mesmo valor la). Minimo 24 caracteres.
IA_INTERNAL_TOKEN="troque-por-um-token-interno-aleatorio"
IA_TIMEOUT_MS=15000

# --- Limites de uso ----------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_DAY=30
RATE_LIMIT_SCAN_PER_MINUTE=10
RATE_LIMIT_FOOD_SEARCH_PER_MINUTE=60
MAX_MEAL_PHOTO_BYTES=5242880
